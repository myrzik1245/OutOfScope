# Текстовые файлы хранятся в репозитории с LF, в рабочей папке — как принято в системе
* text=auto

# Макросы (работают только в .gitattributes в корне репозитория)
[attr]lfs               filter=lfs diff=lfs merge=lfs -text
[attr]unity-json        eol=lf linguist-language=json
[attr]unity-yaml        merge=unityyamlmerge eol=lf linguist-language=yaml linguist-generated

# Исходники Unity
*.cginc                 text
*.compute               text linguist-language=hlsl
*.cs                    text diff=csharp
*.hlsl                  text linguist-language=hlsl
*.raytrace              text linguist-language=hlsl
*.shader                text

# JSON-файлы Unity
*.asmdef                unity-json
*.asmref                unity-json
*.index                 unity-json
*.inputactions          unity-json
*.shadergraph           unity-json
*.shadersubgraph        unity-json

# UI Toolkit
*.tss                   text diff=css linguist-language=css
